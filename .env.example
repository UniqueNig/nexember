# Copy this file to .env.local and fill in the real values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# --- Waitlist → Google Sheets (server-only, never exposed to the browser) ---
# The "Web app" URL you get after deploying google-apps-script/Code.gs
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Any long random string. Must match WAITLIST_SECRET in the Apps Script's Script Properties.
WAITLIST_SECRET=change-me-to-a-long-random-string

# --- Public links (shown on the page) ---
NEXT_PUBLIC_SITE_URL=https://nexember.com
NEXT_PUBLIC_WHATSAPP_URL=https://whatsapp.com/channel/YOUR-CHANNEL-ID
NEXT_PUBLIC_CONTACT_EMAIL=hello@nexember.com
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/YOUR-PAGE
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/YOUR-HANDLE
NEXT_PUBLIC_X_URL=https://x.com/YOUR-HANDLE
